PORT=4000
# Set to "production" in production. This makes auth cookies Secure by default
# (override with COOKIE_SECURE) and is used for general environment checks.
NODE_ENV="production"

DATABASE_URL="postgresql://user:password@host.neon.tech/db?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@host.neon.tech/db?sslmode=require"

JWT_SECRET="change-me-in-production-use-a-long-random-value"
# Optional: salt for hashed referral abuse fingerprints. Falls back to JWT_SECRET.
REFERRAL_FINGERPRINT_SALT="change-me-too"

# Comma-separated browser origins allowed to send credentialed CORS requests.
# Required in production (empty blocks all cross-origin browser requests).
# Example: CORS_ORIGINS="https://app.example.com,https://www.example.com"
# Same-origin deployments (e.g. /api* proxied to this server) need no entries.
CORS_ORIGINS=""

# Auth cookie controls.
#  - Secure defaults to true when NODE_ENV=production; set COOKIE_SECURE=true/false to override.
#  - SameSite defaults to "lax". Use "none" ONLY for a cross-site frontend/API
#    (different registrable domains); "none" forces Secure.
COOKIE_SECURE=""
COOKIE_SAMESITE=""

# Opt-in trusted reverse-proxy hops in front of Express. Leave blank unless a
# proxy/edge is actually in front (e.g. 1 for a single reverse proxy, or
# "loopback"). No default is assumed so no host/edge topology is hardcoded.
TRUST_PROXY=""

# --- Financial activation gates (independent, all default disabled) ---
# Each is enabled ONLY by the exact value "true" (case-sensitive, no surrounding
# spaces). Leave unset/false until the owner approves go-live.
# PAYMENTS_ENABLED: external OxaPay deposits + their settlement/reconciliation.
#   Internal CEO purchases with existing SP balances do NOT depend on this.
# PAYOUTS_ENABLED: real withdrawal payout execution (BEP20). Deposit and payout
#   credentials stay separate.
# REFERRAL_REWARDS_ENABLED: crediting of referral bonuses/commissions. Rewards
#   remain off until qualification criteria are owner-approved.
PAYMENTS_ENABLED="false"
PAYOUTS_ENABLED="false"
REFERRAL_REWARDS_ENABLED="false"

# Deposit access mode: disabled | admin_allowlist | all (default: disabled).
# admin_allowlist permits invoice creation only for role=ADMIN users whose
# immutable numeric User ID is in DEPOSIT_ADMIN_ALLOWLIST (comma-separated).
# Existing invoices still settle via the webhook path when PAYMENTS_ENABLED=true.
# DEPOSIT_ACCESS_MODE="disabled"
# DEPOSIT_ADMIN_ALLOWLIST=""

# Withdrawal wallet-change security hold, in hours. New withdrawal requests are
# blocked for this long after the saved BEP20 wallet changes. Defaults to 24.
WITHDRAWAL_WALLET_HOLD_HOURS="24"

# --- OxaPay (FOUNDATION ONLY — payments and payouts remain disabled) ---
# Placeholders only. Never commit real credentials. The provider foundation
# fails closed while these are empty, and both PAYMENTS_ENABLED and
# PAYOUTS_ENABLED stay false until the owner approves go-live.
# Merchant key signs invoice callbacks (HMAC-SHA512) and authorizes invoice/status.
OXAPAY_MERCHANT_API_KEY=""
# Payout key signs payout callbacks (HMAC-SHA512) and authorizes payouts. Not used yet.
OXAPAY_PAYOUT_API_KEY=""
# Optional general key (account balance). Not used yet.
OXAPAY_GENERAL_API_KEY=""
# Public HTTPS callback URL for OxaPay payment callbacks (no private/localhost).
# Example: https://api.tycoonx.top/api/payments/oxapay/webhook
OXAPAY_CALLBACK_URL=""
# Base URL for the OxaPay v1 API. Defaults to https://api.oxapay.com/v1.
OXAPAY_BASE_URL=""
# "true" enables the provider sandbox flag on invoice creation. Defaults to false.
OXAPAY_SANDBOX=""
# Request timeout in milliseconds. Defaults to 10000.
OXAPAY_TIMEOUT_MS=""
# Provider-verified minimum deposit in USDT. Empty/invalid disables the check.
# Verify against the live OxaPay accepted-currencies minimums before enabling deposits.
OXAPAY_MIN_DEPOSIT_USDT=""
