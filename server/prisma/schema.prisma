generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AppMeta {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  passwordHash String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedCeos        OwnedCeo[]
  referralsMade    ReferralAttribution[] @relation("ReferralReferrer")
  referralReceived ReferralAttribution?  @relation("ReferralReferred")
  idempotencyKeys  IdempotencyKey[]
}

model CEO {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  rarity          String
  priceUsd        Decimal  @db.Decimal(12, 2)
  dailyRatePercent Decimal @db.Decimal(5, 4)
  cycleHours      Int      @default(4)
  energyCost      Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  baseSpPerCycle  Int?
  maxOwned        Int      @default(1)
  isStarter       Boolean  @default(false)
  rewardEligible  Boolean  @default(false)
  category        String?
  displayOrder    Int      @default(0)

  owned           OwnedCeo[]
}

model OwnedCeo {
  id                    Int             @id @default(autoincrement())
  userId                Int
  templateId            Int
  acquisitionType       AcquisitionType
  level                 Int             @default(1)
  cycleLimit            Int?
  completedRewardCycles Int             @default(0)
  status                OwnedCeoStatus  @default(IDLE)
  acquiredAt            DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                  User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  template              CEO             @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([templateId])
  @@index([userId, status])
}

model ReferralAttribution {
  id             Int      @id @default(autoincrement())
  referrerId     Int
  referredUserId Int      @unique
  code           String
  createdAt      DateTime @default(now())
  eligible       Boolean  @default(false)

  referrer       User     @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Restrict)
  referredUser   User     @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Restrict)

  @@index([referrerId])
}

model IdempotencyKey {
  id        Int      @id @default(autoincrement())
  userId    Int
  scope     String
  key       String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
}

enum Role {
  USER
  ADMIN
}

enum AcquisitionType {
  STARTER
  PURCHASE
  MISSION
  REWARD
  ADMIN
}

enum OwnedCeoStatus {
  IDLE
  PRODUCING
  READY_TO_COLLECT
  EXHAUSTED
  PAUSED
  DISABLED
}
