generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AppMeta {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  passwordHash String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedCeos        OwnedCeo[]
  referralsMade    ReferralAttribution[] @relation("ReferralReferrer")
  referralReceived ReferralAttribution?  @relation("ReferralReferred")
  idempotencyKeys  IdempotencyKey[]
  cycles           ProductionCycle[]
  spLedger         SpLedgerEntry[]
  spAccount        SpAccount?
  progress         ProgressAccount?
  taskEvents       TaskEvent[]
  taskClaims       TaskClaim[]
  achievementClaims AchievementClaim[]
  profile          UserProfile?
  withdrawalRequests WithdrawalRequest[]
  consents         PolicyConsent[]
}

model CEO {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  rarity          String
  priceUsd        Decimal  @db.Decimal(12, 2)
  dailyRatePercent Decimal @db.Decimal(5, 4)
  cycleHours      Int      @default(4)
  energyCost      Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  baseSpPerCycle  Int?
  nominalSpPer24h Int?
  lifetimeCapSp   BigInt?
  maxOwned        Int      @default(1)
  isStarter       Boolean  @default(false)
  rewardEligible  Boolean  @default(false)
  category        String?
  displayOrder    Int      @default(0)

  owned           OwnedCeo[]
}

model ProductionCycle {
  id               BigInt                @id @default(autoincrement())
  userId           Int
  ownedCeoId       Int
  status           ProductionCycleStatus @default(PRODUCING)
  startsAt         DateTime              @default(now())
  endsAt           DateTime
  nominalSpPer24hSnap Int
  equipmentSnap    EquipmentTier
  cycleHoursSnap   Int
  rewardSpSnap     BigInt
  lifetimeCapSnap  BigInt
  claimedAt        DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  user             User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  ownedCeo         OwnedCeo              @relation(fields: [ownedCeoId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([ownedCeoId])
  @@index([status, endsAt])
}

model SpAccount {
  userId           Int      @id
  earnedSp         BigInt   @default(0)
  bonusSp          BigInt   @default(0)
  lifetimeEarnedSp BigInt   @default(0)
  version          Int      @default(0)
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model SpLedgerEntry {
  id                   BigInt          @id @default(autoincrement())
  userId               Int
  bucket               SpBucket
  amountSp             BigInt
  balanceAfterEarnedSp BigInt
  balanceAfterBonusSp  BigInt
  sourceType           SpSourceType
  sourceId             BigInt?
  metadata             Json?
  createdAt            DateTime        @default(now())

  user                 User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, sourceType, sourceId, bucket])
  @@index([userId, createdAt])
}

model ProgressAccount {
  userId    Int      @id
  xp        Int      @default(0)
  level     Int      @default(1)
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model TaskEvent {
  id        Int           @id @default(autoincrement())
  userId    Int
  type      TaskEventType
  createdAt DateTime      @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}

model TaskClaim {
  id        Int      @id @default(autoincrement())
  userId    Int
  taskKey   String
  periodKey String
  xpAwarded Int
  claimedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskKey, periodKey])
  @@index([userId, periodKey])
}

model AchievementClaim {
  id        Int      @id @default(autoincrement())
  userId    Int
  trackKey  String
  stage     String
  xpAwarded Int
  claimedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackKey, stage])
}

model UserProfile {
  userId       Int      @id
  avatarKey    String   @default("founder-1")
  featured     Json?
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PolicyConsent {
  id             Int      @id @default(autoincrement())
  userId         Int
  termsVersion   String
  privacyVersion String
  acceptedAt     DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, termsVersion, privacyVersion])
  @@index([userId])
}

model WithdrawalRequest {
  id         Int              @id @default(autoincrement())
  userId     Int
  grossSp    BigInt
  feeUsdt    Decimal          @db.Decimal(12, 2)
  netUsdt    Decimal          @db.Decimal(12, 2)
  address    String
  network    String           @default("BEP20")
  status     WithdrawalStatus @default(REQUESTED)
  note       String?
  reviewedBy Int?
  reviewedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([status, createdAt])
}

model OwnedCeo {
  id                    Int             @id @default(autoincrement())
  userId                Int
  templateId            Int
  acquisitionType       AcquisitionType
  level                 Int             @default(1)
  cycleLimit            Int?
  completedRewardCycles Int             @default(0)
  status                OwnedCeoStatus  @default(IDLE)
  equipment             EquipmentTier   @default(STANDARD)
  lifetimeEarnedSp      BigInt          @default(0)
  archivedAt            DateTime?
  acquiredAt            DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                  User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  template              CEO             @relation(fields: [templateId], references: [id], onDelete: Restrict)
  cycles                ProductionCycle[]

  @@index([userId])
  @@index([templateId])
  @@index([userId, status])
}

model ReferralAttribution {
  id             Int      @id @default(autoincrement())
  referrerId     Int
  referredUserId Int      @unique
  code           String
  createdAt      DateTime @default(now())
  eligible       Boolean  @default(false)

  referrer       User     @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Restrict)
  referredUser   User     @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Restrict)

  @@index([referrerId])
}

model IdempotencyKey {
  id        Int      @id @default(autoincrement())
  userId    Int
  scope     String
  key       String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
}

enum Role {
  USER
  ADMIN
}

enum AcquisitionType {
  STARTER
  PURCHASE
  MISSION
  REWARD
  ADMIN
}

enum OwnedCeoStatus {
  IDLE
  PRODUCING
  READY_TO_COLLECT
  EXHAUSTED
  PAUSED
  DISABLED
}

enum EquipmentTier {
  STANDARD
  EXTENDED
  ADVANCED
}

enum ProductionCycleStatus {
  PRODUCING
  CLAIMED
  CANCELLED
}

enum SpBucket {
  EARNED
  BONUS
}

enum SpSourceType {
  CYCLE_CLAIM
  MISSION_REWARD
  REFERRAL_REWARD
  SPECIAL_TASK_REWARD
  EQUIPMENT_PURCHASE
  ADMIN_ADJUSTMENT
  WITHDRAWAL_LOCK
  WITHDRAWAL_SETTLE
  WITHDRAWAL_RELEASE
}

enum TaskEventType {
  LOGIN
  CYCLE_START
  CYCLE_COLLECT
}

enum WithdrawalStatus {
  REQUESTED
  ON_HOLD
  APPROVED
  REJECTED
  CANCELLED
  PAID
}
