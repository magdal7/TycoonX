generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AppMeta {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  passwordHash String
  role      Role     @default(USER)
  isSuspended Boolean @default(false)
  suspendedAt DateTime?
  suspensionReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedCeos        OwnedCeo[]
  referralsMade    ReferralAttribution[] @relation("ReferralReferrer")
  referralReceived ReferralAttribution?  @relation("ReferralReferred")
  idempotencyKeys  IdempotencyKey[]
  cycles           ProductionCycle[]
  spLedger         SpLedgerEntry[]
  spAccount        SpAccount?
  progress         ProgressAccount?
  taskEvents       TaskEvent[]
  taskClaims       TaskClaim[]
  achievementClaims AchievementClaim[]
  profile          UserProfile?
  withdrawalRequests WithdrawalRequest[]
  consents         PolicyConsent[]
  specialTaskSubmissions SpecialTaskSubmission[]
  paymentIntents   PaymentIntent[]
  purchases        CeoPurchase[]
}

model CEO {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  rarity          String
  priceUsd        Decimal  @db.Decimal(12, 2)
  dailyRatePercent Decimal @db.Decimal(5, 4)
  cycleHours      Int      @default(4)
  energyCost      Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  baseSpPerCycle  Int?
  nominalSpPer24h Int?
  lifetimeCapSp   BigInt?
  maxOwned        Int      @default(1)
  isStarter       Boolean  @default(false)
  rewardEligible  Boolean  @default(false)
  category        String?
  displayOrder    Int      @default(0)
  imageUrl        String?
  isForSale       Boolean  @default(true)

  owned           OwnedCeo[]
  purchases       CeoPurchase[]
}

model ProductionCycle {
  id               BigInt                @id @default(autoincrement())
  userId           Int
  ownedCeoId       Int
  status           ProductionCycleStatus @default(PRODUCING)
  startsAt         DateTime              @default(now())
  endsAt           DateTime
  nominalSpPer24hSnap Int
  equipmentSnap    EquipmentTier
  cycleHoursSnap   Int
  rewardSpSnap     BigInt
  lifetimeCapSnap  BigInt
  claimedAt        DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  user             User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  ownedCeo         OwnedCeo              @relation(fields: [ownedCeoId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([ownedCeoId])
  @@index([status, endsAt])
}

model SpAccount {
  userId           Int      @id
  earnedSp         BigInt   @default(0)
  bonusSp          BigInt   @default(0)
  lifetimeEarnedSp BigInt   @default(0)
  version          Int      @default(0)
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model SpLedgerEntry {
  id                   BigInt          @id @default(autoincrement())
  userId               Int
  bucket               SpBucket
  amountSp             BigInt
  balanceAfterEarnedSp BigInt
  balanceAfterBonusSp  BigInt
  sourceType           SpSourceType
  sourceId             BigInt?
  metadata             Json?
  createdAt            DateTime        @default(now())

  user                 User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, sourceType, sourceId, bucket])
  @@index([userId, createdAt])
}

model ProgressAccount {
  userId    Int      @id
  xp        Int      @default(0)
  level     Int      @default(1)
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model TaskEvent {
  id        Int           @id @default(autoincrement())
  userId    Int
  type      TaskEventType
  createdAt DateTime      @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}

model TaskClaim {
  id        Int      @id @default(autoincrement())
  userId    Int
  taskKey   String
  periodKey String
  xpAwarded Int
  claimedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskKey, periodKey])
  @@index([userId, periodKey])
}

model AchievementClaim {
  id        Int      @id @default(autoincrement())
  userId    Int
  trackKey  String
  stage     String
  xpAwarded Int
  claimedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackKey, stage])
}

model UserProfile {
  userId       Int      @id
  avatarKey    String   @default("founder-1")
  featured     Json?
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PolicyConsent {
  id             Int      @id @default(autoincrement())
  userId         Int
  termsVersion   String
  privacyVersion String
  acceptedAt     DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, termsVersion, privacyVersion])
  @@index([userId])
}

model SpecialTask {
  id                Int                     @id @default(autoincrement())
  title             String
  description       String
  link              String?
  proofInstructions String?
  rewardXp          Int                     @default(0)
  rewardBonusSp     BigInt                  @default(0)
  status            SpecialTaskStatus       @default(DRAFT)
  verification      SpecialTaskVerification @default(MANUAL)
  minLevel          Int                     @default(1)
  maxCompletions    Int?
  completionsCount  Int                     @default(0)
  startsAt          DateTime?
  expiresAt         DateTime?
  createdBy         Int
  publishedAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  submissions       SpecialTaskSubmission[]

  @@index([status, expiresAt])
  @@index([createdBy])
}

model SpecialTaskSubmission {
  id                Int                         @id @default(autoincrement())
  taskId            Int
  userId            Int
  status            SpecialTaskSubmissionStatus @default(PENDING)
  attempt           Int                         @default(1)
  proofText         String?
  proofUrl          String?
  rewardXpSnap      Int
  rewardBonusSpSnap BigInt
  reserved          Boolean                     @default(false)
  reviewNote        String?
  reviewedBy        Int?
  reviewedAt        DateTime?
  claimedAt         DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  task              SpecialTask                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user              User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId, attempt])
  @@index([userId, status])
  @@index([taskId, status])
}

model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model WithdrawalRequest {
  id         Int              @id @default(autoincrement())
  userId     Int
  grossSp    BigInt
  feeUsdt    Decimal          @db.Decimal(12, 2)
  netUsdt    Decimal          @db.Decimal(12, 2)
  address    String
  network    String           @default("BEP20")
  status     WithdrawalStatus @default(REQUESTED)
  note       String?
  reviewedBy Int?
  reviewedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([status, createdAt])
}

model OwnedCeo {
  id                    Int             @id @default(autoincrement())
  userId                Int
  templateId            Int
  acquisitionType       AcquisitionType
  level                 Int             @default(1)
  cycleLimit            Int?
  completedRewardCycles Int             @default(0)
  status                OwnedCeoStatus  @default(IDLE)
  equipment             EquipmentTier   @default(STANDARD)
  lifetimeEarnedSp      BigInt          @default(0)
  archivedAt            DateTime?
  acquiredAt            DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                  User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  template              CEO             @relation(fields: [templateId], references: [id], onDelete: Restrict)
  cycles                ProductionCycle[]

  @@index([userId])
  @@index([templateId])
  @@index([userId, status])
}

model ReferralAttribution {
  id             Int            @id @default(autoincrement())
  referrerId     Int
  referredUserId Int            @unique
  code           String
  status         ReferralStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  eligible       Boolean        @default(false)
  qualifiedAt    DateTime?
  reviewedBy     Int?
  reviewedAt     DateTime?
  reviewNote     String?
  signupIpHash   String?
  signupUserAgentHash String?
  updatedAt      DateTime       @updatedAt

  referrer       User     @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Restrict)
  referredUser   User     @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Restrict)
  rewards        ReferralReward[]
  purchases      ReferralPurchaseEvent[]

  @@index([referrerId])
  @@index([referrerId, status])
  @@index([signupIpHash])
}

model ReferralReward {
  id             Int                   @id @default(autoincrement())
  referralId     Int
  kind           ReferralRewardKind
  status         ReferralRewardStatus  @default(PENDING)
  amountSp       BigInt
  currency       String                @default("BONUS_SP")
  purchaseRef    String                @default("")
  ledgerSourceId BigInt?
  reason         String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  paidAt         DateTime?
  reversedAt     DateTime?

  referral       ReferralAttribution   @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@unique([referralId, kind, purchaseRef])
  @@index([referralId])
  @@index([status])
}

model ReferralPurchaseEvent {
  id             Int                    @id @default(autoincrement())
  referralId     Int
  referredUserId Int
  purchaseRef    String                 @unique
  valueSp        BigInt
  status         ReferralPurchaseStatus @default(PENDING)
  occurredAt     DateTime
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  referral       ReferralAttribution    @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId])
  @@index([status])
}

model PaymentIntent {
  id           Int                 @id @default(autoincrement())
  userId       Int
  provider     PaymentProvider     @default(OXAPAY)
  externalId   String              @unique
  amountUsdt   Decimal             @db.Decimal(18, 6)
  creditedSp   BigInt?
  status       PaymentIntentStatus @default(CREATED)
  purpose      String              @default("deposit")
  payAddress   String?
  payUrl       String?
  metadata     Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  confirmedAt  DateTime?

  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  purchases    CeoPurchase[]
  events       PaymentWebhookEvent[]

  @@index([userId, status])
}

model PaymentWebhookEvent {
  id              Int                @id @default(autoincrement())
  provider        PaymentProvider
  eventId         String
  paymentIntentId Int?
  status          PaymentEventStatus @default(RECEIVED)
  payload         Json
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?

  paymentIntent   PaymentIntent?     @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([status])
}

model CeoPurchase {
  id              Int             @id @default(autoincrement())
  userId          Int
  ceoId           Int
  priceUsdSnap    Decimal         @db.Decimal(12, 2)
  status          PurchaseStatus  @default(PENDING)
  paymentIntentId Int?
  ownedCeoId      Int?            @unique
  idempotencyKey  String          @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  paidAt          DateTime?
  deliveredAt     DateTime?

  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  ceo             CEO             @relation(fields: [ceoId], references: [id], onDelete: Restrict)
  paymentIntent   PaymentIntent?  @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

model IdempotencyKey {
  id        Int      @id @default(autoincrement())
  userId    Int
  scope     String
  key       String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
}

enum Role {
  USER
  ADMIN
}

enum AcquisitionType {
  STARTER
  PURCHASE
  MISSION
  REWARD
  ADMIN
}

enum OwnedCeoStatus {
  IDLE
  PRODUCING
  READY_TO_COLLECT
  EXHAUSTED
  PAUSED
  DISABLED
}

enum EquipmentTier {
  STANDARD
  EXTENDED
  ADVANCED
}

enum ProductionCycleStatus {
  PRODUCING
  CLAIMED
  CANCELLED
}

enum SpBucket {
  EARNED
  BONUS
}

enum SpSourceType {
  CYCLE_CLAIM
  MISSION_REWARD
  REFERRAL_REWARD
  SPECIAL_TASK_REWARD
  EQUIPMENT_PURCHASE
  ADMIN_ADJUSTMENT
  WITHDRAWAL_LOCK
  WITHDRAWAL_SETTLE
  WITHDRAWAL_RELEASE
  DEPOSIT_CREDIT
}

enum TaskEventType {
  LOGIN
  CYCLE_START
  CYCLE_COLLECT
}

enum WithdrawalStatus {
  REQUESTED
  ON_HOLD
  APPROVED
  REJECTED
  CANCELLED
  PAID
}

enum SpecialTaskStatus {
  DRAFT
  PUBLISHED
  PAUSED
  EXPIRED
  ARCHIVED
}

enum SpecialTaskVerification {
  MANUAL
  AUTO
}

enum SpecialTaskSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  CLAIMED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REJECTED
  REVOKED
}

enum ReferralRewardKind {
  REGISTRATION_BONUS
  PURCHASE_COMMISSION
}

enum ReferralRewardStatus {
  PENDING
  PAID
  REVERSED
}

enum ReferralPurchaseStatus {
  PENDING
  SETTLED
  FAILED
  REFUNDED
  CHARGEBACK
  DUPLICATE
}

enum PaymentProvider {
  OXAPAY
  MANUAL
}

enum PaymentIntentStatus {
  CREATED
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
  CANCELLED
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum PurchaseStatus {
  PENDING
  PAID
  DELIVERED
  FAILED
  REFUNDED
}
